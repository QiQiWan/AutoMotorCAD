MOTORCAD_STUDIO_HOST=127.0.0.1
MOTORCAD_STUDIO_PORT=8765
MOTORCAD_STUDIO_DATA_DIR=./data
MOTORCAD_STUDIO_RUNTIME_DIR=./data/runtime
MOTORCAD_STUDIO_RESULTS_DIR=./data/results
MOTORCAD_STUDIO_BASELINES_DIR=./data/baselines
MOTORCAD_STUDIO_FACTORY_DIR=./data/factory
MOTORCAD_STUDIO_DEFAULT_SOLVER=motorcad
MOTORCAD_STUDIO_MOTORCAD_VISIBLE=false
MOTORCAD_STUDIO_MAX_WORKERS=2
MOTORCAD_STUDIO_CASE_PARALLELISM=2
MOTORCAD_STUDIO_ENABLE_MOCK=false
MOTORCAD_STUDIO_MOCK_DELAY=0.08
MOTORCAD_STUDIO_SOLVER_TIMEOUT=7200
MOTORCAD_STUDIO_CANCEL_GRACE=5
MOTORCAD_STUDIO_MOTORCAD_VERSION=2026R1
MOTORCAD_STUDIO_STRICT_MAPPING=true
MOTORCAD_STUDIO_MODEL_POLICY=development
MOTORCAD_STUDIO_REUSE_INSTANCES=true
MOTORCAD_STUDIO_WORKER_MODE=persistent
MOTORCAD_STUDIO_MOTORCAD_POOL_SIZE=2
MOTORCAD_STUDIO_WORKER_RECYCLE_JOBS=20
MOTORCAD_STUDIO_WORKER_RECYCLE_RSS_MB=4096
MOTORCAD_STUDIO_WORKER_ACQUIRE_TIMEOUT=1800
# If the persistent Python owner/pipe itself fails, retry this Case once in an isolated process.
# Engineering/model errors never trigger this fallback.
MOTORCAD_STUDIO_WORKER_FALLBACK_ISOLATED=true

# Optional explicit Motor-CAD executable; otherwise V0.5 scans and auto-selects target version.
MOTORCAD_STUDIO_MOTORCAD_EXE=
MOTORCAD_STUDIO_USE_BLACKBOX_LICENCE=

# V0.7 local licence scheduling capacities. Set these to actual concurrent entitlements.
MOTORCAD_STUDIO_LICENSE_EMAG=2
MOTORCAD_STUDIO_LICENSE_THERMAL=1
MOTORCAD_STUDIO_LICENSE_LAB=1
MOTORCAD_STUDIO_LICENSE_MECHANICAL=1
MOTORCAD_STUDIO_LICENSE_WAIT_TIMEOUT=1800
# V0.27 atomic runtime scheduler
MOTORCAD_STUDIO_RUNTIME_MIN_FREE_MEMORY_MB=1536
MOTORCAD_STUDIO_RUNTIME_CASE_MEMORY_MB=1024
MOTORCAD_STUDIO_RUNTIME_SCHEDULER_TIMEOUT=1800
MOTORCAD_STUDIO_RUNTIME_CONTRACT_STALE_HOURS=168

