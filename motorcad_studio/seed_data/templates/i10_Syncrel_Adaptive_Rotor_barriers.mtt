[AdaptiveTemplates]
AdaptiveTemplates_Script[0]="""""""Adaptive Templates script to alter SYNCREL U-Shape rotor template to use curved rotor pockets."
AdaptiveTemplates_Script[1]="This script does not support:"
AdaptiveTemplates_Script[2]="    Zero inner/outer layer thickness"
AdaptiveTemplates_Script[3]="    Inner/outer posts"
AdaptiveTemplates_Script[4]=""""""""
AdaptiveTemplates_Script[5]="import ansys.motorcad.core as pymotorcad"
AdaptiveTemplates_Script[6]="from ansys.motorcad.core.geometry import Arc, Coordinate, Line, rt_to_xy, xy_to_rt"
AdaptiveTemplates_Script[7]=""
AdaptiveTemplates_Script[8]="# Connect to Motor-CAD"
AdaptiveTemplates_Script[9]="mc = pymotorcad.MotorCAD(open_new_instance=False)"
AdaptiveTemplates_Script[10]=""
AdaptiveTemplates_Script[11]=""
AdaptiveTemplates_Script[12]="def get_barrier_centre_and_radius(coordinate_1, coordinate_2, coordinate_3, arc_direction):"
AdaptiveTemplates_Script[13]="    """"""Calculate barrier arc centre and radius coordinates."
AdaptiveTemplates_Script[14]=""
AdaptiveTemplates_Script[15]="    Parameters"
AdaptiveTemplates_Script[16]="    ----------"
AdaptiveTemplates_Script[17]="    coordinate_1 : Coordinate"
AdaptiveTemplates_Script[18]="        Arc start coordinate."
AdaptiveTemplates_Script[19]=""
AdaptiveTemplates_Script[20]="    coordinate_2 : Coordinate"
AdaptiveTemplates_Script[21]="        Extra coordinate on arc"
AdaptiveTemplates_Script[22]=""
AdaptiveTemplates_Script[23]="    coordinate_3 : Coordinate"
AdaptiveTemplates_Script[24]="        Arc end coordinate"
AdaptiveTemplates_Script[25]=""
AdaptiveTemplates_Script[26]="    arc_direction : Integer"
AdaptiveTemplates_Script[27]="        Direction to create arc between start/end"
AdaptiveTemplates_Script[28]=""
AdaptiveTemplates_Script[29]="    Returns"
AdaptiveTemplates_Script[30]="    -------"
AdaptiveTemplates_Script[31]="    radius : float"
AdaptiveTemplates_Script[32]="        Arc radius"
AdaptiveTemplates_Script[33]=""
AdaptiveTemplates_Script[34]="    centre : Coordinate"
AdaptiveTemplates_Script[35]="        Arc centre coordinate"
AdaptiveTemplates_Script[36]="    """""""
AdaptiveTemplates_Script[37]="    _, start_t = xy_to_rt(coordinate_1.x, coordinate_1.y)"
AdaptiveTemplates_Script[38]="    _, end_t = xy_to_rt(coordinate_3.x, coordinate_3.y)"
AdaptiveTemplates_Script[39]=""
AdaptiveTemplates_Script[40]="    a = ("
AdaptiveTemplates_Script[41]="        coordinate_1.x * (coordinate_2.y - coordinate_3.y)"
AdaptiveTemplates_Script[42]="        - coordinate_1.y * (coordinate_2.x - coordinate_3.x)"
AdaptiveTemplates_Script[43]="        + coordinate_2.x * coordinate_3.y"
AdaptiveTemplates_Script[44]="        - coordinate_3.x * coordinate_2.y"
AdaptiveTemplates_Script[45]="    )"
AdaptiveTemplates_Script[46]="    b = ("
AdaptiveTemplates_Script[47]="        (coordinate_1.x**2 + coordinate_1.y**2) * (coordinate_3.y - coordinate_2.y)"
AdaptiveTemplates_Script[48]="        + (coordinate_2.x**2 + coordinate_2.y**2) * (coordinate_1.y - coordinate_3.y)"
AdaptiveTemplates_Script[49]="        + (coordinate_3.x**2 + coordinate_3.y**2) * (coordinate_2.y - coordinate_1.y)"
AdaptiveTemplates_Script[50]="    )"
AdaptiveTemplates_Script[51]="    c = ("
AdaptiveTemplates_Script[52]="        (coordinate_1.x**2 + coordinate_1.y**2) * (coordinate_2.x - coordinate_3.x)"
AdaptiveTemplates_Script[53]="        + (coordinate_2.x**2 + coordinate_2.y**2) * (coordinate_3.x - coordinate_1.x)"
AdaptiveTemplates_Script[54]="        + (coordinate_3.x**2 + coordinate_3.y**2) * (coordinate_1.x - coordinate_2.x)"
AdaptiveTemplates_Script[55]="    )"
AdaptiveTemplates_Script[56]="    centre = Coordinate((-b / a) / 2, (-c / a) / 2)"
AdaptiveTemplates_Script[57]="    radius = Line(centre, coordinate_1).length * arc_direction"
AdaptiveTemplates_Script[58]=""
AdaptiveTemplates_Script[59]="    return radius, centre"
AdaptiveTemplates_Script[60]=""
AdaptiveTemplates_Script[61]=""
AdaptiveTemplates_Script[62]="def get_pockets_include_corner_rounding():"
AdaptiveTemplates_Script[63]="    """"""Whether corner rounding should be applied to pocket."
AdaptiveTemplates_Script[64]=""
AdaptiveTemplates_Script[65]="    Returns"
AdaptiveTemplates_Script[66]="    -------"
AdaptiveTemplates_Script[67]="        boolean"
AdaptiveTemplates_Script[68]="    """""""
AdaptiveTemplates_Script[69]="    return (mc.get_variable(""CornerRounding_Rotor"") == 1) and ("
AdaptiveTemplates_Script[70]="        mc.get_variable(""CornerRoundingRadius_Rotor"") > 0"
AdaptiveTemplates_Script[71]="    )"
AdaptiveTemplates_Script[72]=""
AdaptiveTemplates_Script[73]=""
AdaptiveTemplates_Script[74]="def get_rotor_mirror_line():"
AdaptiveTemplates_Script[75]="    """"""Create mirror line through rotor from origin to airgap."
AdaptiveTemplates_Script[76]=""
AdaptiveTemplates_Script[77]="    Returns"
AdaptiveTemplates_Script[78]="    -------"
AdaptiveTemplates_Script[79]="        Line"
AdaptiveTemplates_Script[80]="    """""""
AdaptiveTemplates_Script[81]="    rotor_radius = mc.get_variable(""RotorDiameter"")"
AdaptiveTemplates_Script[82]="    number_poles = mc.get_variable(""Pole_Number"")"
AdaptiveTemplates_Script[83]="    airgap_centre_x, airgap_centre_y = rt_to_xy(rotor_radius, (360 / number_poles) / 2)"
AdaptiveTemplates_Script[84]=""
AdaptiveTemplates_Script[85]="    return Line(Coordinate(0, 0), Coordinate(airgap_centre_x, airgap_centre_y))"
AdaptiveTemplates_Script[86]=""
AdaptiveTemplates_Script[87]=""
AdaptiveTemplates_Script[88]="def get_coordinates(pocket, coordinate_indices, mirror_line=None):"
AdaptiveTemplates_Script[89]="    """"""Get list of coordinates from pocket using coordinate_indices."
AdaptiveTemplates_Script[90]="    Coordinates ordered : start, end, extra coordinate on arc."
AdaptiveTemplates_Script[91]=""
AdaptiveTemplates_Script[92]="    Parameters"
AdaptiveTemplates_Script[93]="    ----------"
AdaptiveTemplates_Script[94]="    pocket : Region"
AdaptiveTemplates_Script[95]="        Pocket region"
AdaptiveTemplates_Script[96]=""
AdaptiveTemplates_Script[97]="    coordinate_indices : list of integer"
AdaptiveTemplates_Script[98]="        Pocket region coordinate indices"
AdaptiveTemplates_Script[99]=""
AdaptiveTemplates_Script[100]="    mirror_line : Line"
AdaptiveTemplates_Script[101]="        Mirror line to generate extra coordinate on arc"
AdaptiveTemplates_Script[102]=""
AdaptiveTemplates_Script[103]="    Returns"
AdaptiveTemplates_Script[104]="    -------"
AdaptiveTemplates_Script[105]="        list of Coordinate"
AdaptiveTemplates_Script[106]="    """""""
AdaptiveTemplates_Script[107]="    coordinates = [pocket.points[index] for index in coordinate_indices]"
AdaptiveTemplates_Script[108]="    if mirror_line is not None:"
AdaptiveTemplates_Script[109]="        # mirror first coordinate to generate third coordinate on arc"
AdaptiveTemplates_Script[110]="        coordinates.append(coordinates[0].mirror(mirror_line))"
AdaptiveTemplates_Script[111]=""
AdaptiveTemplates_Script[112]="    return coordinates"
AdaptiveTemplates_Script[113]=""
AdaptiveTemplates_Script[114]=""
AdaptiveTemplates_Script[115]="def get_coordinates_no_centre_post(pocket):"
AdaptiveTemplates_Script[116]="    """"""Get list of coordinates to use to generate top and bottom arcs for pocket."
AdaptiveTemplates_Script[117]="    Coordinates ordered : start, end, extra coordinate for each arc."
AdaptiveTemplates_Script[118]=""
AdaptiveTemplates_Script[119]="    Returns"
AdaptiveTemplates_Script[120]="    -------"
AdaptiveTemplates_Script[121]="        list of Coordinate"
AdaptiveTemplates_Script[122]="    """""""
AdaptiveTemplates_Script[123]="    # return coordinates at indices from pocket.points, these indices match up with"
AdaptiveTemplates_Script[124]="    # coordinates from each pocket region with/without corner rounding"
AdaptiveTemplates_Script[125]="    # coordinate index ordering [start, end, centre, start, end, centre]"
AdaptiveTemplates_Script[126]="    # indices have been selected using Motor-CAD geometry editor "
AdaptiveTemplates_Script[127]="    if get_pockets_include_corner_rounding():"
AdaptiveTemplates_Script[128]="        return get_coordinates(pocket, [2, 8, 5, 11, 17, 14])"
AdaptiveTemplates_Script[129]="    else:"
AdaptiveTemplates_Script[130]="        return get_coordinates(pocket, [1, 5, 3, 6, 0, 8])"
AdaptiveTemplates_Script[131]=""
AdaptiveTemplates_Script[132]=""
AdaptiveTemplates_Script[133]="def get_coordinates_centre_post(pocket):"
AdaptiveTemplates_Script[134]="    """"""Get list of coordinates to use to generate top and bottom arcs for pocket."
AdaptiveTemplates_Script[135]="    Coordinates ordered : start, end, extra coordinate for each arc."
AdaptiveTemplates_Script[136]=""
AdaptiveTemplates_Script[137]="    Parameters"
AdaptiveTemplates_Script[138]="    ----------"
AdaptiveTemplates_Script[139]="    pocket : Region"
AdaptiveTemplates_Script[140]="        Pocket region"
AdaptiveTemplates_Script[141]=""
AdaptiveTemplates_Script[142]="    Returns"
AdaptiveTemplates_Script[143]="    -------"
AdaptiveTemplates_Script[144]="        list of Coordinate"
AdaptiveTemplates_Script[145]="    """""""
AdaptiveTemplates_Script[146]="    # mirror required to generate the third point on arc, this third point is required"
AdaptiveTemplates_Script[147]="    # to calculate the centre and radius of arc, the mirror line mirrors  the start point"
AdaptiveTemplates_Script[148]="    # of each pocket arc to generate this third point"
AdaptiveTemplates_Script[149]="    mirror = get_rotor_mirror_line()"
AdaptiveTemplates_Script[150]="    # return coordinates at indices from pocket.points, these indices match up with"
AdaptiveTemplates_Script[151]="    # coordinates from each pocket region with/without corner rounding"
AdaptiveTemplates_Script[152]="    # coordinate index ordering [start, end, centre, start, end, centre]"
AdaptiveTemplates_Script[153]="    # indices have been selected using Motor-CAD geometry editor "
AdaptiveTemplates_Script[154]="    if get_pockets_include_corner_rounding():"
AdaptiveTemplates_Script[155]="        return get_coordinates(pocket, [2, 5], mirror) + get_coordinates("
AdaptiveTemplates_Script[156]="            pocket, [8, 11], mirror_line=mirror"
AdaptiveTemplates_Script[157]="        )"
AdaptiveTemplates_Script[158]="    else:"
AdaptiveTemplates_Script[159]="        return get_coordinates(pocket, [1, 3], mirror) + get_coordinates("
AdaptiveTemplates_Script[160]="            pocket, [4, 0], mirror_line=mirror"
AdaptiveTemplates_Script[161]="        )"
AdaptiveTemplates_Script[162]=""
AdaptiveTemplates_Script[163]=""
AdaptiveTemplates_Script[164]="def update_pocket_geometry(pocket, coordinates):"
AdaptiveTemplates_Script[165]="    """"""Update the pocket entities to create curved pocket using input coordinates."
AdaptiveTemplates_Script[166]=""
AdaptiveTemplates_Script[167]="    Parameters"
AdaptiveTemplates_Script[168]="    ----------"
AdaptiveTemplates_Script[169]="    pocket : Region"
AdaptiveTemplates_Script[170]="        Pocket region"
AdaptiveTemplates_Script[171]=""
AdaptiveTemplates_Script[172]="    coordinates : list of Coordinate"
AdaptiveTemplates_Script[173]="        Coordinates to generate arcs with in region"
AdaptiveTemplates_Script[174]="    """""""
AdaptiveTemplates_Script[175]="    entities = []"
AdaptiveTemplates_Script[176]="    # create list of arc entities from coordinates"
AdaptiveTemplates_Script[177]="    for element in range(0, len(coordinates), 3):"
AdaptiveTemplates_Script[178]="        if (element + 1) % 2 == 0:"
AdaptiveTemplates_Script[179]="            # clockwise arc"
AdaptiveTemplates_Script[180]="            arc_direction = -1"
AdaptiveTemplates_Script[181]="        else:"
AdaptiveTemplates_Script[182]="            # ant-clockwise arc"
AdaptiveTemplates_Script[183]="            arc_direction = 1"
AdaptiveTemplates_Script[184]=""
AdaptiveTemplates_Script[185]="        # get arc radius and centre point from three coordinates across the arc"
AdaptiveTemplates_Script[186]="        radius, centre = get_barrier_centre_and_radius("
AdaptiveTemplates_Script[187]="            coordinates[element],  # arc start coordinate"
AdaptiveTemplates_Script[188]="            coordinates[element + 1],  # arc end coordinate"
AdaptiveTemplates_Script[189]="            coordinates[element + 2],  # arc third coordinate"
AdaptiveTemplates_Script[190]="            arc_direction,"
AdaptiveTemplates_Script[191]="        )"
AdaptiveTemplates_Script[192]="        entities.append("
AdaptiveTemplates_Script[193]="            Arc("
AdaptiveTemplates_Script[194]="                coordinates[element],"
AdaptiveTemplates_Script[195]="                coordinates[element + 1],"
AdaptiveTemplates_Script[196]="                centre,"
AdaptiveTemplates_Script[197]="                radius,"
AdaptiveTemplates_Script[198]="            )"
AdaptiveTemplates_Script[199]="        )"
AdaptiveTemplates_Script[200]="    # remove entities between start and end coordinates of each arc then insert into pocket"
AdaptiveTemplates_Script[201]="    for count, element in enumerate(range(0, len(coordinates), 3)):"
AdaptiveTemplates_Script[202]="        start_index = pocket.points.index(coordinates[element])"
AdaptiveTemplates_Script[203]="        end_index = pocket.points.index(coordinates[element + 1])"
AdaptiveTemplates_Script[204]="        if end_index == 0:"
AdaptiveTemplates_Script[205]="            end_index = len(pocket.points)"
AdaptiveTemplates_Script[206]=""
AdaptiveTemplates_Script[207]="        # use index of start/end coordinates to remove pockets entities between them"
AdaptiveTemplates_Script[208]="        for index in reversed(range(start_index, end_index)):"
AdaptiveTemplates_Script[209]="            pocket.entities.pop(index)"
AdaptiveTemplates_Script[210]=""
AdaptiveTemplates_Script[211]="        pocket.insert_entity(start_index, entities[count])"
AdaptiveTemplates_Script[212]=""
AdaptiveTemplates_Script[213]=""
AdaptiveTemplates_Script[214]="def get_pocket_name(index):"
AdaptiveTemplates_Script[215]="    """"""Return unique pocket name used in Motor-CAD."
AdaptiveTemplates_Script[216]=""
AdaptiveTemplates_Script[217]="    Parameters"
AdaptiveTemplates_Script[218]="    ----------"
AdaptiveTemplates_Script[219]="    index : integer"
AdaptiveTemplates_Script[220]="        Current pocket index"
AdaptiveTemplates_Script[221]=""
AdaptiveTemplates_Script[222]="    Returns"
AdaptiveTemplates_Script[223]="    -------"
AdaptiveTemplates_Script[224]="        string"
AdaptiveTemplates_Script[225]="    """""""
AdaptiveTemplates_Script[226]="    if index == 0:"
AdaptiveTemplates_Script[227]="        return ""Rotor Pocket"""
AdaptiveTemplates_Script[228]="    else:"
AdaptiveTemplates_Script[229]="        return ""Rotor Pocket_"" + str(index)"
AdaptiveTemplates_Script[230]=""
AdaptiveTemplates_Script[231]=""
AdaptiveTemplates_Script[232]="pocket_number = 0"
AdaptiveTemplates_Script[233]="number_layers = mc.get_variable(""Magnet_Layers"")"
AdaptiveTemplates_Script[234]=""
AdaptiveTemplates_Script[235]="for layer in range(number_layers):"
AdaptiveTemplates_Script[236]="    # get U-Shape layer parameters"
AdaptiveTemplates_Script[237]="    outer_thickness = mc.get_array_variable(""UShape_Thickness_Outer_Array"", layer)"
AdaptiveTemplates_Script[238]="    outer_post_width = mc.get_array_variable(""UShape_Post_Outer_Array"", layer)"
AdaptiveTemplates_Script[239]="    inner_thickness = mc.get_array_variable(""UShape_Thickness_Inner_Array"", layer)"
AdaptiveTemplates_Script[240]="    inner_post_width = mc.get_array_variable(""UShape_Post_Inner_Array"", layer)"
AdaptiveTemplates_Script[241]="    centre_post_width = mc.get_array_variable(""UShape_CentrePost_Array"", layer)"
AdaptiveTemplates_Script[242]=""
AdaptiveTemplates_Script[243]="    if (inner_thickness == 0) or (outer_thickness == 0):"
AdaptiveTemplates_Script[244]="        message_string = ("
AdaptiveTemplates_Script[245]="            ""Unable to create curved barrier for layer """
AdaptiveTemplates_Script[246]="            + str(layer)"
AdaptiveTemplates_Script[247]="            + "". No inner/outer thickness."""
AdaptiveTemplates_Script[248]="        )"
AdaptiveTemplates_Script[249]="        raise Exception(message_string)"
AdaptiveTemplates_Script[250]="    elif (outer_post_width > 0) or (inner_post_width > 0):"
AdaptiveTemplates_Script[251]="        message_string = ("
AdaptiveTemplates_Script[252]="            ""Unable to create curved barrier for layer """
AdaptiveTemplates_Script[253]="            + str(layer)"
AdaptiveTemplates_Script[254]="            + "". Inner/Outer post width > 0"""
AdaptiveTemplates_Script[255]="        )"
AdaptiveTemplates_Script[256]="        raise Exception(message_string)"
AdaptiveTemplates_Script[257]=""
AdaptiveTemplates_Script[258]="    # get pocket from Motor-CAD using unique name"
AdaptiveTemplates_Script[259]="    pocket_left = mc.get_region(get_pocket_name(pocket_number))"
AdaptiveTemplates_Script[260]=""
AdaptiveTemplates_Script[261]="    if centre_post_width == 0:"
AdaptiveTemplates_Script[262]="        # no centre post, single rotor pocket in layer"
AdaptiveTemplates_Script[263]="        new_coordinates = get_coordinates_no_centre_post(pocket_left)"
AdaptiveTemplates_Script[264]="    else:"
AdaptiveTemplates_Script[265]="        # centre post, two pockets per layer"
AdaptiveTemplates_Script[266]="        new_coordinates = get_coordinates_centre_post(pocket_left)"
AdaptiveTemplates_Script[267]=""
AdaptiveTemplates_Script[268]="    update_pocket_geometry(pocket_left, new_coordinates)"
AdaptiveTemplates_Script[269]="    # increment pocket number to get next pocket from Motor-CAD"
AdaptiveTemplates_Script[270]="    pocket_number += 1"
AdaptiveTemplates_Script[271]=""
AdaptiveTemplates_Script[272]="    if pocket_left.is_closed():"
AdaptiveTemplates_Script[273]="        # set region back into Motor-CAD"
AdaptiveTemplates_Script[274]="        mc.set_region(pocket_left)"
AdaptiveTemplates_Script[275]=""
AdaptiveTemplates_Script[276]="    if centre_post_width > 0:"
AdaptiveTemplates_Script[277]="        # mirror left barrier/pocket region across the rotor using mirror line"
AdaptiveTemplates_Script[278]="        pocket_right = pocket_left.mirror(get_rotor_mirror_line(), unique_name=False)"
AdaptiveTemplates_Script[279]="        pocket_right.name = get_pocket_name(pocket_number)"
AdaptiveTemplates_Script[280]="        # increment pocket number to get next pocket from Motor-CAD"
AdaptiveTemplates_Script[281]="        pocket_number += 1"
AdaptiveTemplates_Script[282]=""
AdaptiveTemplates_Script[283]="        if pocket_right.is_closed():"
AdaptiveTemplates_Script[284]="            # set region back into Motor-CAD"
AdaptiveTemplates_Script[285]="            mc.set_region(pocket_right)"
AdaptiveTemplates_Script[286]=""
