[AdaptiveTemplates]
AdaptiveTemplates_Script[0]=""""""""
AdaptiveTemplates_Script[1]="Triangular Rotor Notches for IPM"
AdaptiveTemplates_Script[2]="================================"
AdaptiveTemplates_Script[3]="This script applies the adaptive templates functionality to create triangular rotor notches to"
AdaptiveTemplates_Script[4]="improve NVH performance."
AdaptiveTemplates_Script[5]=""""""""
AdaptiveTemplates_Script[6]=""
AdaptiveTemplates_Script[7]="# This script uses the following adaptive parameters:"
AdaptiveTemplates_Script[8]="#"
AdaptiveTemplates_Script[9]="# * Notch Angle (-4)"
AdaptiveTemplates_Script[10]="#"
AdaptiveTemplates_Script[11]="# * Notch Sweep (5)"
AdaptiveTemplates_Script[12]="#"
AdaptiveTemplates_Script[13]="# * Notch Depth (1)"
AdaptiveTemplates_Script[14]="#"
AdaptiveTemplates_Script[15]="# * Notches per Pole (2)"
AdaptiveTemplates_Script[16]="#"
AdaptiveTemplates_Script[17]="# If these parameters are not already set up in the Motor-CAD file, the parameters will be"
AdaptiveTemplates_Script[18]="# automatically set, with the default values shown in brackets."
AdaptiveTemplates_Script[19]=""
AdaptiveTemplates_Script[20]="# %%"
AdaptiveTemplates_Script[21]="# Perform Required imports"
AdaptiveTemplates_Script[22]="# ------------------------"
AdaptiveTemplates_Script[23]="# Import the ``pymotorcad`` package to access Motor-CAD. Import the ``triangular_notch``"
AdaptiveTemplates_Script[24]="# function to create the notch geometry region with Adaptive Templates geometry."
AdaptiveTemplates_Script[25]="# Import ``sys`` to load the template into Motor-CAD if running externally."
AdaptiveTemplates_Script[26]=""
AdaptiveTemplates_Script[27]="import sys"
AdaptiveTemplates_Script[28]=""
AdaptiveTemplates_Script[29]="import ansys.motorcad.core as pymotorcad"
AdaptiveTemplates_Script[30]="from ansys.motorcad.core.geometry import RegionType"
AdaptiveTemplates_Script[31]="from ansys.motorcad.core.geometry_shapes import triangular_notch"
AdaptiveTemplates_Script[32]=""
AdaptiveTemplates_Script[33]="# %%"
AdaptiveTemplates_Script[34]="# Connect to Motor-CAD"
AdaptiveTemplates_Script[35]="# --------------------"
AdaptiveTemplates_Script[36]="mc = pymotorcad.MotorCAD(open_new_instance=False)"
AdaptiveTemplates_Script[37]=""
AdaptiveTemplates_Script[38]="# Reset geometry to default"
AdaptiveTemplates_Script[39]="mc.reset_adaptive_geometry()"
AdaptiveTemplates_Script[40]=""
AdaptiveTemplates_Script[41]="# %%"
AdaptiveTemplates_Script[42]="# Set Adaptive Parameters if required"
AdaptiveTemplates_Script[43]="# -----------------------------------"
AdaptiveTemplates_Script[44]="# Four Adaptive Parameters are required for this adaptive template. These are used to define the"
AdaptiveTemplates_Script[45]="# number of rotor notches to be added, their position and size."
AdaptiveTemplates_Script[46]="#                                                                                                                                                                       "
AdaptiveTemplates_Script[47]="# If the Adaptive Parameters have already been set in the current Motor-CAD file, their current"
AdaptiveTemplates_Script[48]="# values will be used. Otherwise, the Adaptive Parameters will be defined and set to default values."
AdaptiveTemplates_Script[49]="#"
AdaptiveTemplates_Script[50]="# Use the ``set_adaptive_parameter_default`` method to set the required parameters if undefined."
AdaptiveTemplates_Script[51]="mc.set_adaptive_parameter_default(""Notch Angle"", -4)"
AdaptiveTemplates_Script[52]="mc.set_adaptive_parameter_default(""Notch Sweep"", 5)"
AdaptiveTemplates_Script[53]="mc.set_adaptive_parameter_default(""Notch Depth"", 1)"
AdaptiveTemplates_Script[54]="mc.set_adaptive_parameter_default(""Notches per Pole"", 2)"
AdaptiveTemplates_Script[55]=""
AdaptiveTemplates_Script[56]="                                                                                                                                               "
AdaptiveTemplates_Script[57]="# %%"
AdaptiveTemplates_Script[58]="# Get required parameters and objects"
AdaptiveTemplates_Script[59]="# -----------------------------------"
AdaptiveTemplates_Script[60]="# Get the Adaptive Parameters specified in Motor-CAD, and their values"
AdaptiveTemplates_Script[61]="notch_angle = mc.get_adaptive_parameter_value(""notch angle"")"
AdaptiveTemplates_Script[62]="notch_angular_width = mc.get_adaptive_parameter_value(""notch sweep"")"
AdaptiveTemplates_Script[63]="notch_depth = mc.get_adaptive_parameter_value(""notch depth"")"
AdaptiveTemplates_Script[64]="number_notches = int(mc.get_adaptive_parameter_value(""notches per pole""))"
AdaptiveTemplates_Script[65]=""
AdaptiveTemplates_Script[66]="# %%"
AdaptiveTemplates_Script[67]="# Get the standard template rotor region from Motor-CAD. Calculate the rotor radius and define the"
AdaptiveTemplates_Script[68]="# rotor centre coordinates."
AdaptiveTemplates_Script[69]="rotor_region = mc.get_region(""Rotor"")"
AdaptiveTemplates_Script[70]=""
AdaptiveTemplates_Script[71]="rotor_radius = mc.get_variable(""RotorDiameter"") / 2"
AdaptiveTemplates_Script[72]="duplication_angle = 360 / rotor_region.duplications"
AdaptiveTemplates_Script[73]=""
AdaptiveTemplates_Script[74]="# %%"
AdaptiveTemplates_Script[75]="# Add an ``if`` statement to account for the case when a notch crosses the symmetry boundary. This"
AdaptiveTemplates_Script[76]="# resets ``notch_angle`` to half the ``notch_angular_width`` away from the boundary."
AdaptiveTemplates_Script[77]="if notch_angle > (duplication_angle / (2 * number_notches)) - (notch_angular_width / 2):"
AdaptiveTemplates_Script[78]="    # Limit so notch does not cross the symmetry boundary"
AdaptiveTemplates_Script[79]="    notch_angle = (duplication_angle / (2 * number_notches)) - notch_angular_width / 2"
AdaptiveTemplates_Script[80]="    mc.show_message(""Adaptive Parameter: 'notch angle' not valid, reset to "" + str(notch_angle))"
AdaptiveTemplates_Script[81]="    mc.set_adaptive_parameter_value(""notch angle"", notch_angle)"
AdaptiveTemplates_Script[82]=""
AdaptiveTemplates_Script[83]="# %%"
AdaptiveTemplates_Script[84]="# Add an ``if`` statement to account for the case when notches overlap at the centre of the pole."
AdaptiveTemplates_Script[85]="# This resets ``notch_angle`` to:"
AdaptiveTemplates_Script[86]="#"
AdaptiveTemplates_Script[87]="# * Half the ``notch_angular_width`` away from the pole centre when there are an even number of"
AdaptiveTemplates_Script[88]="#   notches"
AdaptiveTemplates_Script[89]="#"
AdaptiveTemplates_Script[90]="# * The full ``notch_angular_width`` away from the pole centre when there are an odd number of"
AdaptiveTemplates_Script[91]="#   notches"
AdaptiveTemplates_Script[92]="if number_notches % 2 == 0:"
AdaptiveTemplates_Script[93]="    x = -1"
AdaptiveTemplates_Script[94]="else:"
AdaptiveTemplates_Script[95]="    x = -2"
AdaptiveTemplates_Script[96]=""
AdaptiveTemplates_Script[97]="if notch_angle < -((duplication_angle / (2 * number_notches)) - (notch_angular_width / 2)):"
AdaptiveTemplates_Script[98]="    # Limit so notches do not overlap at centre of pole"
AdaptiveTemplates_Script[99]="    notch_angle = x * ((duplication_angle / (2 * number_notches)) - notch_angular_width / 2)"
AdaptiveTemplates_Script[100]="    mc.show_message(""Adaptive Parameter: 'notch angle' not valid, reset to "" + str(notch_angle))"
AdaptiveTemplates_Script[101]="    mc.set_adaptive_parameter_value(""notch angle"", notch_angle)"
AdaptiveTemplates_Script[102]=""
AdaptiveTemplates_Script[103]="# %%"
AdaptiveTemplates_Script[104]="# Create the Adaptive Templates geometry"
AdaptiveTemplates_Script[105]="# --------------------------------------"
AdaptiveTemplates_Script[106]="# For each notch to be added:"
AdaptiveTemplates_Script[107]="#"
AdaptiveTemplates_Script[108]="# * Calculate the angular position of the notch in mechanical degrees"
AdaptiveTemplates_Script[109]="#"
AdaptiveTemplates_Script[110]="# * Apply the offset angle. For notches on the left side of the pole, the position is shifted by"
AdaptiveTemplates_Script[111]="#   ``+ notch_angle`` mechanical degrees. For notches on the right side of the pole, the position is"
AdaptiveTemplates_Script[112]="#   shifted by ``- notch_angle`` mechanical degrees."
AdaptiveTemplates_Script[113]="#"
AdaptiveTemplates_Script[114]="# * Create the notch Region using the ``triangular_notch()`` function, imported from"
AdaptiveTemplates_Script[115]="#   ``ansys.motorcad.core.geometry_shapes``. The arguments for the function are:"
AdaptiveTemplates_Script[116]="#"
AdaptiveTemplates_Script[117]="#   * rotor_radius"
AdaptiveTemplates_Script[118]="#"
AdaptiveTemplates_Script[119]="#   * notch_angular_width"
AdaptiveTemplates_Script[120]="#"
AdaptiveTemplates_Script[121]="#   * notch_centre_angle"
AdaptiveTemplates_Script[122]="#"
AdaptiveTemplates_Script[123]="#   * notch_depth"
AdaptiveTemplates_Script[124]="#"
AdaptiveTemplates_Script[125]="# * Define the properties for the notch region"
AdaptiveTemplates_Script[126]="#"
AdaptiveTemplates_Script[127]="#   * name"
AdaptiveTemplates_Script[128]="#"
AdaptiveTemplates_Script[129]="#   * colour"
AdaptiveTemplates_Script[130]="#"
AdaptiveTemplates_Script[131]="#   * duplication angle"
AdaptiveTemplates_Script[132]="#"
AdaptiveTemplates_Script[133]="#   * material"
AdaptiveTemplates_Script[134]="#"
AdaptiveTemplates_Script[135]="# * set the notch's ``parent`` to the rotor region. This will allow Motor-CAD to treat the notch as"
AdaptiveTemplates_Script[136]="#   a sub-region of the rotor and handle subtractions automatically."
AdaptiveTemplates_Script[137]="#"
AdaptiveTemplates_Script[138]="# * If the notch is closed, set the region in Motor-CAD."
AdaptiveTemplates_Script[139]=""
AdaptiveTemplates_Script[140]="for notch_loop in range(0, number_notches):"
AdaptiveTemplates_Script[141]="    notch_name = ""Rotor_Notch_"" + str(notch_loop + 1)"
AdaptiveTemplates_Script[142]=""
AdaptiveTemplates_Script[143]="    # angular position of notch"
AdaptiveTemplates_Script[144]="    notch_centre_angle = ((2 * notch_loop) + 1) * (duplication_angle / (2 * number_notches))"
AdaptiveTemplates_Script[145]=""
AdaptiveTemplates_Script[146]="    # Offset angle by notch_angle"
AdaptiveTemplates_Script[147]="    if notch_centre_angle < duplication_angle / 2:"
AdaptiveTemplates_Script[148]="        notch_centre_angle = notch_centre_angle - notch_angle"
AdaptiveTemplates_Script[149]="    if notch_centre_angle > duplication_angle / 2:"
AdaptiveTemplates_Script[150]="        notch_centre_angle = notch_centre_angle + notch_angle"
AdaptiveTemplates_Script[151]=""
AdaptiveTemplates_Script[152]="    # generate a triangular notch region"
AdaptiveTemplates_Script[153]="    notch = triangular_notch("
AdaptiveTemplates_Script[154]="        rotor_radius,"
AdaptiveTemplates_Script[155]="        notch_angular_width,"
AdaptiveTemplates_Script[156]="        notch_centre_angle,"
AdaptiveTemplates_Script[157]="        notch_depth,"
AdaptiveTemplates_Script[158]="        region_type=RegionType.rotor_pocket,"
AdaptiveTemplates_Script[159]="    )"
AdaptiveTemplates_Script[160]=""
AdaptiveTemplates_Script[161]="    # notch properties"
AdaptiveTemplates_Script[162]="    notch.name = notch_name"
AdaptiveTemplates_Script[163]="    notch.colour = (255, 255, 255)"
AdaptiveTemplates_Script[164]="    notch.duplications = rotor_region.duplications"
AdaptiveTemplates_Script[165]="    notch.material = ""Air"""
AdaptiveTemplates_Script[166]="    notch.parent = rotor_region"
AdaptiveTemplates_Script[167]=""
AdaptiveTemplates_Script[168]="    if notch.is_closed():"
AdaptiveTemplates_Script[169]="        mc.set_region(notch)"
AdaptiveTemplates_Script[170]="      "
AdaptiveTemplates_Script[171]="# %%"
AdaptiveTemplates_Script[172]="# Load in Adaptive Templates script if required"
AdaptiveTemplates_Script[173]="# ---------------------------------------------"
AdaptiveTemplates_Script[174]="# When this script is run externally, the script executes the following:"
AdaptiveTemplates_Script[175]="#"
AdaptiveTemplates_Script[176]="# * Set **Geometry type** to **Adaptive**."
AdaptiveTemplates_Script[177]="#"
AdaptiveTemplates_Script[178]="# * Load the script into the **Adaptive Templates** tab."
AdaptiveTemplates_Script[179]="#"
AdaptiveTemplates_Script[180]="# * Go to the **Geometry -> Radial** tab to run the Adaptive Templates script and display the new"
AdaptiveTemplates_Script[181]="#   geometry."
AdaptiveTemplates_Script[182]=""
AdaptiveTemplates_Script[183]="if not pymotorcad.is_running_in_internal_scripting():"
AdaptiveTemplates_Script[184]="    mc.set_variable(""GeometryTemplateType"", 1)"
AdaptiveTemplates_Script[185]="    mc.load_adaptive_script(sys.argv[0])"
AdaptiveTemplates_Script[186]="    mc.display_screen(""Geometry;Radial"")   "
AdaptiveTemplates_ScriptFileName=
AdaptiveTemplates_ScriptLines=187
