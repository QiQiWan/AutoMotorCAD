# MotorCAD Studio repository ignore rules
# Keep source, contracts, manifests, tests and documentation under version control.

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build / packaging outputs
build/
dist/
*.egg-info/
*.egg

# IDE / editor metadata
.vscode/
.idea/
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# MotorCAD Studio mutable runtime state (top-level only)
/data/
/runtime/
/results/
/logs/
/baselines/
/factory/

# Local databases / diagnostics generated during development
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

# Local environment files / secrets
.env
.env.*
!.env.example

# Temporary files
*.tmp
*.temp
*.bak
*.orig
*.rej

# Local archives and ad-hoc release bundles
/*.zip
/*.7z
/*.tar
/*.tar.gz
